# Copy to .env.local for local dev. Set the real values in Railway → Variables.
# NEVER commit real keys: a key in a public repo is a key published to the world.

# NewsData.io — headlines. https://newsdata.io/
NEWSDATA_API_KEY=

# SAHMK — Tadawul-licensed Saudi market data. https://www.sahmk.sa/en/developers
# Free plan = 100 requests/day. lib/market.ts makes one call per 15 minutes
# (96/day) to stay inside it. Raising the refresh rate will break the quota.
SAHMK_API_KEY=
# SAHMK_BASE_URL=https://api.sahmk.sa/api/v1

# Twelve Data — global ticker context (S&P 500, Nasdaq, gold, WTI, EUR/USD)
# alongside the Tadawul strip. https://twelvedata.com/account/api-keys
# Free plan = 800 credits/day, 8/minute. lib/globalTicks.ts batches 5 symbols
# on the same 15-minute window as SAHMK (~480 credits/day). Without this key
# the strip just shows Tadawul + the fallback levels, nothing fabricated.
TWELVEDATA_API_KEY=

# Morning brief signup. Until this is set, /api/subscribe returns 503 and the
# form honestly tells the reader signups are not open.
MARSA_SUBSCRIBE_WEBHOOK=
MARSA_SUBSCRIBE_TOKEN=
